<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="crm_lead_partner_field_mapping_view_tree" model="ir.ui.view">
        <field name="name">crm.lead.partner.field.mapping.tree</field>
        <field name="model">crm.lead.partner.field.mapping</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="sequence" widget="handle" />
                <field name="lead_field_id" options="{'no_create': True}" />
                <field name="partner_field_id" options="{'no_create': True}" />
                <field name="apply_to" />
                <field name="active" widget="boolean_toggle" />
            </tree>
        </field>
    </record>

    <record id="crm_lead_partner_field_mapping_view_search" model="ir.ui.view">
        <field name="name">crm.lead.partner.field.mapping.search</field>
        <field name="model">crm.lead.partner.field.mapping</field>
        <field name="arch" type="xml">
            <search>
                <field name="lead_field_id" />
                <field name="partner_field_id" />
                <filter
                    name="filter_archived"
                    string="Archived"
                    domain="[('active', '=', False)]"
                />
                <group name="group_by">
                    <filter
                        name="group_by_apply_to"
                        string="Apply To"
                        context="{'group_by': 'apply_to'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="crm_lead_partner_field_mapping_action" model="ir.actions.act_window">
        <field name="name">Lead to Partner Fields</field>
        <field name="res_model">crm.lead.partner.field.mapping</field>
        <field name="view_mode">tree</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Map a lead field to a partner field
            </p>
            <p>
                The mapped values are copied to the partner created from a lead.
            </p>
        </field>
    </record>

    <menuitem
        id="crm_menu_config_customer_creation"
        name="Customer Creation"
        parent="crm.crm_menu_config"
        groups="sales_team.group_sale_manager"
        sequence="50"
    />

    <menuitem
        id="crm_lead_partner_field_mapping_menu"
        action="crm_lead_partner_field_mapping_action"
        parent="crm_menu_config_customer_creation"
        groups="sales_team.group_sale_manager"
        sequence="10"
    />

</odoo>
