<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <!-- Lead+opportunity form -->
    <record id="crm_lead_view_form" model="ir.ui.view">
        <field name="name">crm.lead.form.delivery.date</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form" />
        <field name="arch" type="xml">

            <!-- there are separate groups for leads/opportunities in core form -->
            <xpath expr="(//field[@name='tag_ids'])[1]" position="before">
                <field name="delivery_date" />
            </xpath>

            <xpath expr="(//field[@name='tag_ids'])[2]" position="before">
                <field name="delivery_date" />
            </xpath>
        </field>
    </record>

    <!-- Lead tree -->
    <record id="crm_case_tree_view_leads" model="ir.ui.view">
        <field name="name">crm.lead.tree.lead.delivery.date</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_case_tree_view_leads" />
        <field name="arch" type="xml">
            <field name="user_id" position="after">
                <field name="delivery_date" optional="hide" />
            </field>
        </field>
    </record>

    <!-- Lead kanban -->
    <record id="view_crm_lead_kanban" model="ir.ui.view">
        <field name="name">crm.lead.kanban.lead.delivery.date</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.view_crm_lead_kanban" />
        <field name="arch" type="xml">

            <field name="user_id" position="after">
                <field name="delivery_date" />
            </field>

            <xpath expr="//div[hasclass('o_kanban_record_bottom')]" position="before">
                <div>
                    <div t-if="record.delivery_date.value">
                        Delivery Date:<br />
                        <span t-esc="record.delivery_date.value" />
                    </div>
                </div>
            </xpath>
        </field>
    </record>

    <!-- Opportunity tree -->
    <record id="crm_case_tree_view_oppor" model="ir.ui.view">
        <field name="name">crm.lead.tree.opportunity.delivery.date</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_case_tree_view_oppor" />
        <field name="arch" type="xml">
            <field name="user_id" position="after">
                <field name="delivery_date" optional="hide" />
            </field>
        </field>
    </record>

    <!-- Opportunity kanban -->
    <record id="crm_case_kanban_view_leads" model="ir.ui.view">
        <field name="name">crm.lead.kanban.opportunity.delivery.date</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_case_kanban_view_leads" />
        <field name="arch" type="xml">

            <field name="team_id" position="after">
                <field name="delivery_date" />
            </field>

            <xpath expr="//div[hasclass('oe_kanban_content')]" position="inside">
                <div>
                    <div t-if="record.delivery_date.value">
                        Delivery Date:<br />
                        <span t-esc="record.delivery_date.value" />
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
