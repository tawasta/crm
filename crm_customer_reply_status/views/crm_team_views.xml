<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="crm_team_view_form" model="ir.ui.view">
        <field name="name">crm.team.form.customer.reply</field>
        <field name="model">crm.team</field>
        <field name="inherit_id" ref="sales_team.crm_team_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Customer Reply Notifications">
                    <field name="customer_reply_notify"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="crm_team_member_view_form" model="ir.ui.view">
        <field name="name">crm.team.member.form.customer.reply</field>
        <field name="model">crm.team.member</field>
        <field name="inherit_id" ref="sales_team.crm_team_member_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet//group" position="inside">
                <field name="customer_reply_notify"/>
            </xpath>
        </field>
    </record>
</odoo>