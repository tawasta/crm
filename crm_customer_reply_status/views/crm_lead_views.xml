<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_crm_case_opportunities_filter" model="ir.ui.view">
        <field name="name">crm.lead.search.customer.reply</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.view_crm_case_opportunities_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <filter
                    name="customer_replied"
                    string="Customer Replied"
                    domain="[('customer_replied', '=', True)]"
                />
            </xpath>
        </field>
    </record>

    <record id="crm_case_kanban_view_leads" model="ir.ui.view">
        <field name="name">crm.lead.kanban.customer.reply</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_case_kanban_view_leads"/>
        <field name="arch" type="xml">
            <xpath expr="//kanban" position="inside">
                <field name="customer_replied"/>
                <field name="customer_reply_date"/>
            </xpath>

            <xpath expr="//field[@name='tag_ids']" position="after">
                <div invisible="not customer_replied" class="mt-1">
                    <span class="badge rounded-pill text-bg-warning">
                        Customer Replied
                    </span>
                </div>
            </xpath>
        </field>
    </record>

    <record id="crm_lead_view_form" model="ir.ui.view">
        <field name="name">crm.lead.form.customer.reply</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Customer Reply">
                    <field name="customer_replied"/>
                    <field name="customer_reply_date"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>