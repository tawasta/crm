<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="crm_lead_map_view" model="ir.ui.view">
        <field name="name">Map</field>
        <field name="type">CRMLeadMapView</field>
        <field name="model">crm.lead</field>
        <field name="arch" type="xml">
            <CRMLeadMapView
                text="name"
                latitude="customer_latitude"
                longitude="customer_longitude"
            />
        </field>
    </record>

    <record id="crm.crm_lead_action_pipeline" model="ir.actions.act_window">
        <field
            name="view_mode"
        >kanban,tree,graph,pivot,form,calendar,activity,CRMLeadMapView</field>
    </record>

    <record
        id="crm.crm_case_form_view_salesteams_opportunity"
        model="ir.actions.act_window"
    >
        <field
            name="view_mode"
        >kanban,tree,graph,form,calendar,pivot,CRMLeadMapView</field>
    </record>

</odoo>
